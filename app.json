{
  "expo": {
    "name": "Foset",
    "slug": "foset",
    "scheme": "foset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.biligo.foset"
    },
    "android": {
      "package": "dev.biligo.foset",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Foset needs your photo library so you can add clothes you have already photographed.",
          "cameraPermission": "Foset needs the camera so you can photograph a piece of clothing."
        }
      ],
      "expo-font"
    ]
  }
}
